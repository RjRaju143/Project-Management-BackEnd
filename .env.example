NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/freelancer-crm
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# SMTP config (for sending invite emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=FreelancerCRM <your-email@gmail.com>